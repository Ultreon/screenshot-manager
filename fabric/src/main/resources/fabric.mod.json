{
  "schemaVersion": 1,
  "id": "screenshotmgr",
  "version": "${version}",
  "name": "Screenshot Manager",
  "description": "A literal screenshot manager.",
  "authors": [
    {
      "name": "Ultreon",
      "contact": {
        "homepage": "https://ultreon.dev",
        "sources": "https://gitlab.com/ultreon"
      }
    }
  ],
  "contributors": [
    {
      "name": "XyperCode",
      "contact": {
        "homepage": "https://xypercode.github.io",
        "sources": "https://github.com/XyperCode"
      }
    }
  ],
  "contact": {
    "homepage": "https://gitlab.com/ultreon/mods/screenshot-manager",
    "sources": "https://gitlab.com/ultreon/mods/screenshot-manager",
