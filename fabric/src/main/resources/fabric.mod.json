  "depends": {
    "fabric-language-kotlin": ">=1.9.0+kotlin.3.8.0",
    "forgeconfigapiport": ">=8 <9",
    "architectury": ">=9.1 <10",
    "ultreonlib": ">=1.4.0",
    "fabricloader": ">=0.14.12",
    "minecraft": ">=1.20 <=1.20.1"
